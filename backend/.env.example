# ─── Modo de execução ──────────────────────────────────────────────────────
# True  = desenvolvimento (SECRET_KEY gerada automaticamente, logs verbosos)
# False = produção (SECRET_KEY obrigatória, erros 500 sem stack trace)
DEBUG=True

# ─── Segurança JWT ─────────────────────────────────────────────────────────
# OBRIGATÓRIO em produção (DEBUG=False).
# Gere uma chave segura com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Tempo de expiração do token JWT em minutos (padrão: 30)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ─── Usuário administrador (seed automático no startup) ────────────────────
# Criado na inicialização se ainda não existir. A senha deve ter no mínimo
# 8 caracteres, com ao menos uma maiúscula e um número.
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=Admin@123

# ─── Banco de Dados ────────────────────────────────────────────────────────
# Desenvolvimento: SQLite local (sem configuração necessária)
DATABASE_URL=sqlite:///./sql_app.db

# Produção: PostgreSQL (exemplo)
# DATABASE_URL=postgresql://user:password@localhost:5432/roboadvisor

# ─── Servidor ──────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# Recuperação de senha: configure seu serviço SMTP com STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
FRONTEND_URL=http://localhost:8080
LLM_PROVIDER=deterministic
# Opcional: LLM_PROVIDER=ollama para roteamento semântico local.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# Fixe SECRET_KEY para manter tokens e segredos MFA entre reinicializações.

# ─── CORS — origens permitidas ────────────────────────────────────────────
# Lista separada por vírgulas. Em produção, coloque apenas o domínio do frontend.
# CORS_ORIGINS=["https://meuapp.com","https://www.meuapp.com"]
